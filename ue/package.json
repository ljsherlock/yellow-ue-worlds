    "ue:fab-vnc": "bash scripts/vm.sh fab-vnc",
    "ue:run": "bash scripts/vm.sh run",
    "ue:run:rc": "bash scripts/vm.sh run-rc",
    "ue:rc-tunnel": "bash scripts/vm.sh rc-tunnel",
    "ue:stop-app": "bash scripts/vm.sh stop-app",
