    "ue:status": "bash scripts/vm.sh status",
    "ue:ip": "bash scripts/vm.sh ip",
    "ue:ssh": "bash scripts/vm.sh ssh",
    "ue:sync": "bash scripts/vm.sh sync",
    "ue:fix-perms": "bash scripts/vm.sh fix-perms",
