# Copy to `.env` (same folder) and fill in. `.env` is gitignored.
# The brain loads this automatically on startup.

# Your Google Gemini API key. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Force a provider: "gemini" or "fake".
# If unset, the brain uses Gemini when GOOGLE_API_KEY is present, else Fake.
# BRAIN_PROVIDER=gemini

# Optional. Override the Gemini model (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Service bind host/port (defaults shown).
# BRAIN_HOST=127.0.0.1
# BRAIN_PORT=8000
