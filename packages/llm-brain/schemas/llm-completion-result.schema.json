{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "toolCalls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "SetSkyState"
              },
              "args": {
                "type": "object",
                "properties": {
                  "preset": {
                    "type": "string",
                    "enum": [
                      "clear",
                      "cloudy",
                      "storm",
                      "sunset",
                      "night"
                    ]
                  },
                  "transition_seconds": {
                    "default": 5,
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "preset",
                  "transition_seconds"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "tool",
              "args"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "AdvanceTime"
              },
              "args": {
                "type": "object",
                "properties": {
                  "hours": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "speed_multiplier": {
                    "default": 1,
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "hours",
                  "speed_multiplier"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "tool",
              "args"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "SpawnTrees"
              },
              "args": {
                "type": "object",
                "properties": {
                  "area": {
                    "type": "object",
                    "properties": {
                      "center": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "additionalProperties": false
                      },
                      "radius": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "center",
                      "radius"
                    ],
                    "additionalProperties": false
                  },
                  "count": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "species": {
                    "type": "string",
                    "enum": [
                      "oak",
                      "pine",
                      "birch"
                    ]
                  },
                  "growth_stage": {
                    "default": "mature",
                    "type": "string",
                    "enum": [
                      "seedling",
                      "sapling",
                      "mature"
                    ]
                  }
                },
                "required": [
                  "area",
                  "count",
                  "species",
                  "growth_stage"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "tool",
              "args"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "reasoning": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "finishReason": {
      "type": "string",
      "enum": [
        "stop",
        "length",
        "tool_calls",
        "content_filter"
      ]
    }
  },
  "required": [
    "toolCalls",
    "reasoning",
    "model",
    "tokens",
    "finishReason"
  ],
  "additionalProperties": false
}
